              <div><div style={{ fontSize: 10, opacity: 0.7 }}>Ratchasuda</div><div style={{ fontSize: 11, fontWeight: 600 }}>Technical</div></div>
            </div>
          </div>
        </div>
      </div>

      {/* Stats Row */}
      <div style={{ padding: "20px 32px", display: "flex", gap: 16, flexWrap: "wrap" }}>
        <StatCard label="CBO Sites Enrolled" value={totalSites} sub="across 9 provinces" color={COLORS.purple} />
        <StatCard label="Avg QA/QI Score" value={avgScore} sub={avgScore >= 70 ? "Above threshold" : "Below threshold"} color={COLORS.teal} />
        <StatCard label="Avg DQA Error Rate" value={`${avgDQA}%`} sub="Target: <15%" color={parseFloat(avgDQA) < 15 ? COLORS.green : COLORS.gold} />
        <StatCard label="Providers Trained" value="187" sub="of ~200 target" color={COLORS.blue} />
        <StatCard label="CQI Cycles Completed" value="42" sub="across all sites" color={COLORS.green} />
      </div>

      {/* Tab Navigation */}
      <div style={{ padding: "0 32px", borderBottom: "1px solid #E0E0E0", background: COLORS.white }}>
        <div style={{ display: "flex", gap: 4 }}>
          <TabButton active={activeTab === "overview"} onClick={() => setActiveTab("overview")}>Overview</TabButton>
          <TabButton active={activeTab === "cascade"} onClick={() => setActiveTab("cascade")}>RRTTPR Cascade</TabButton>
          <TabButton active={activeTab === "aaaq"} onClick={() => setActiveTab("aaaq")}>AAAQ Framework</TabButton>
          <TabButton active={activeTab === "provinces"} onClick={() => setActiveTab("provinces")}>Provinces</TabButton>
          <TabButton active={activeTab === "sites"} onClick={() => setActiveTab("sites")}>CBO Sites</TabButton>
          <TabButton active={activeTab === "cqi"} onClick={() => setActiveTab("cqi")}>CQI Tracker</TabButton>
          <TabButton active={activeTab === "dqa"} onClick={() => setActiveTab("dqa")}>DQA</TabButton>
        </div>
      </div>

      {/* Content */}
      <div style={{ padding: "24px 32px" }}>
        {activeTab === "overview" && (
          <div style={{ display: "flex", flexDirection: "column", gap: 24 }}>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 24 }}>
              <div style={{ background: COLORS.white, borderRadius: 12, padding: 20, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
                <CascadeView />
              </div>
              <div style={{ background: COLORS.white, borderRadius: 12, padding: 20, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
                <AAAQView />
              </div>
            </div>
            <div style={{ background: COLORS.white, borderRadius: 12, padding: 20, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
              <h3 style={{ color: COLORS.dark, margin: "0 0 12px", fontSize: 16 }}>CQIM Quality Verification Flow</h3>
              <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 8, padding: 16, flexWrap: "wrap" }}>
                {[
                  { label: "CBO Service\nDelivery", color: COLORS.purple, sub: "RRTTPR Cascade" },
                  { label: "→", color: "transparent" },
                  { label: "QA/QI\nAssessment", color: COLORS.teal, sub: "AAAQ Standards" },
                  { label: "→", color: "transparent" },
                  { label: "DQA\nVerification", color: COLORS.blue, sub: "Data Integrity" },
                  { label: "→", color: "transparent" },
                  { label: "CLM\nFeedback", color: COLORS.gold, sub: "Community Voice" },
                  { label: "→", color: "transparent" },
                  { label: "CQI\nCycle", color: COLORS.green, sub: "Improvements" },
                  { label: "→", color: "transparent" },
                  { label: "NHSO\nCompliance", color: COLORS.red, sub: "Financing" },
                ].map((step, i) => (
                  step.label === "→" ? (
                    <span key={i} style={{ fontSize: 24, color: COLORS.gray }}>→</span>
                  ) : (
                    <div key={i} style={{
                      background: step.color,
                      color: COLORS.white,
                      padding: "14px 18px",
                      borderRadius: 10,
                      textAlign: "center",
                      minWidth: 100,
                      whiteSpace: "pre-line",
                      fontSize: 13,
                      fontWeight: 600,
                      lineHeight: 1.4,
                    }}>
                      {step.label}
                      <div style={{ fontSize: 10, opacity: 0.8, marginTop: 4 }}>{step.sub}</div>
                    </div>
                  )
                ))}
              </div>
            </div>
          </div>
        )}
        {activeTab === "cascade" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <CascadeView />
          </div>
        )}
        {activeTab === "aaaq" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <AAAQView />
          </div>
        )}
        {activeTab === "provinces" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <ProvinceView />
          </div>
        )}
        {activeTab === "sites" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <SiteView />
          </div>
        )}
        {activeTab === "cqi" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <CQIView />
          </div>
        )}
        {activeTab === "dqa" && (
          <div style={{ background: COLORS.white, borderRadius: 12, padding: 24, boxShadow: "0 2px 12px rgba(0,0,0,0.06)" }}>
            <DQAView />
          </div>
        )}
      </div>

      {/* Footer */}
      <div style={{
        padding: "16px 32px",
        textAlign: "center",
        fontSize: 11,
        color: COLORS.gray,
        borderTop: `1px solid #E0E0E0`,
      }}>
        CQIM Dashboard Prototype · R2S Consortium (RSAT · SWING · Ratchasuda Institute) · EpiC-2026-002 · FHI 360 / U.S. Department of State
      </div>
    </div>
  );
}
