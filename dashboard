function StatCard({ label, value, sub, color, icon }) {
  return (
    <div style={{
      background: COLORS.white,
      borderRadius: 12,
      padding: "20px 24px",
      borderLeft: `4px solid ${color}`,
      boxShadow: "0 2px 12px rgba(0,0,0,0.06)",
      flex: 1,
      minWidth: 180,
    }}>
      <div style={{ fontSize: 13, color: COLORS.gray, marginBottom: 4 }}>{label}</div>
      <div style={{ fontSize: 28, fontWeight: 700, color: COLORS.dark }}>{value}</div>
      {sub && <div style={{ fontSize: 12, color, marginTop: 4 }}>{sub}</div>}
    </div>
  );
}

function ProgressBar({ value, max = 100, color, height = 8, showLabel = true }) {
  const pct = Math.min((value / max) * 100, 100);
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 8, width: "100%" }}>
      <div style={{
        flex: 1,
        background: "#E0E0E0",
        borderRadius: height / 2,
        height,
        overflow: "hidden",
      }}>
        <div style={{
          width: `${pct}%`,
          background: color,
          height: "100%",
          borderRadius: height / 2,
          transition: "width 0.6s ease",
        }} />
      </div>
      {showLabel && <span style={{ fontSize: 12, fontWeight: 600, color: COLORS.dark, minWidth: 40 }}>{value}%</span>}
    </div>
  );
}

function ScoreBadge({ score }) {
  const color = score >= 80 ? COLORS.green : score >= 65 ? COLORS.gold : COLORS.red;
  const bg = score >= 80 ? COLORS.greenPale : score >= 65 ? COLORS.goldPale : COLORS.redPale;
  return (
    <span style={{
      background: bg,
      color,
      padding: "3px 10px",
      borderRadius: 20,
      fontSize: 13,
      fontWeight: 600,
    }}>{score}</span>
  );
}

function StatusBadge({ status }) {
  const map = {
    "Active": { bg: COLORS.greenPale, color: COLORS.green },
    "CQI Action": { bg: COLORS.goldPale, color: "#E65100" },
    "Needs Support": { bg: COLORS.redPale, color: COLORS.red },
  };
  const s = map[status] || map["Active"];
  return (
    <span style={{
      background: s.bg,
      color: s.color,
      padding: "3px 10px",
      borderRadius: 20,
      fontSize: 12,
      fontWeight: 600,
    }}>{status}</span>
  );
}

